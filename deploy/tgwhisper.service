[Unit]
Description=TgWhisper Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tgwhisper
Group=tgwhisper
WorkingDirectory=/opt/tgwhisper/current
EnvironmentFile=/etc/tgwhisper.env
ExecStart=/opt/tgwhisper/current/.venv/bin/tgwhisper

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tgwhisper

[Install]
WantedBy=multi-user.target
